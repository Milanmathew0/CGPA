<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CGPA Calculator"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SQLite Subject Manager"
            android:textSize="16sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/subjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject name"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="12dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA" />

        <EditText
            android:id="@+id/grade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grade point (0-10)"
            android:inputType="numberDecimal|numberSigned"
            android:minHeight="48dp"
            android:padding="12dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA" />

        <!-- Credits -->
        <EditText
            android:id="@+id/credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Credits"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:padding="12dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Subject"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <!-- Update Button -->
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Selected Subject"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Selected Subject"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F" />

        <!-- Clear Button -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Form"
            android:textColor="#FFFFFF"
            android:backgroundTint="#616161" />

        <!-- Saved Subjects Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Subjects"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- Empty Message -->
        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No subjects saved yet."
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:padding="12dp" />

        <!-- Subject List -->
        <ListView
            android:id="@+id/listSubjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#444444"
            android:dividerHeight="1dp"
            android:nestedScrollingEnabled="false"
            android:choiceMode="singleChoice"
            android:background="#000000" />

        <!-- Calculate CGPA Button -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate CGPA"
            android:textColor="#FFFFFF"
            android:backgroundTint="#008577"
            android:layout_marginTop="16dp" />

        <!-- CGPA Result -->
        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your CGPA will appear here"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#64B5F6"
            android:gravity="center"
            android:padding="20dp" />

    </LinearLayout>

</ScrollView>